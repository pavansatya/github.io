---
import { site } from '../data/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const items = [
  { href: '/work', label: 'Work' },
  { href: '/pipeline', label: 'Pipeline' },
  { href: '/sql', label: 'SQL' },
  { href: '/about', label: 'About' },
  { href: '/resume', label: 'Résumé' },
];
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-50 border-b border-line bg-canvas/85 backdrop-blur-md">
  <nav class="shell flex h-16 items-center justify-between gap-4" aria-label="Primary">
    <a href="/" class="group flex items-center gap-2.5 font-mono text-sm" aria-label="{site.shortName} — home">
      <span
        class="grid h-8 w-8 place-items-center rounded-md border border-line-bright bg-panel text-[11px] font-semibold tracking-tight text-accent transition-colors group-hover:border-accent"
        >{site.initials}</span
      >
      <span class="hidden font-semibold tracking-tight text-fg sm:inline">{site.shortName}</span>
    </a>

    <!-- desktop -->
    <div class="hidden items-center gap-1 md:flex">
      {
        items.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 font-mono text-[13px] transition-colors',
              isActive(item.href) ? 'text-accent' : 'text-fg-dim hover:text-fg',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/contact"
        class="ml-2 rounded-md border border-accent/40 bg-accent/10 px-4 py-2 font-mono text-[13px] font-medium text-accent transition-colors hover:bg-accent/20"
        >Get in touch</a
      >
    </div>

    <!-- mobile -->
    <button
      type="button"
      id="nav-toggle"
      class="grid h-10 w-10 place-items-center rounded-md border border-line text-fg-dim md:hidden"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Open menu"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    </button>
  </nav>

  <div id="nav-menu" hidden class="border-t border-line bg-panel md:hidden">
    <div class="shell flex flex-col py-2">
      {
        [...items, { href: '/contact', label: 'Get in touch' }].map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-2 py-3 font-mono text-sm',
              isActive(item.href) ? 'text-accent' : 'text-fg-dim',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (menu) menu.hidden = open;
  });
</script>
