---
import Base from '../layouts/Base.astro';
import { site, publication } from '../data/site';

/**
 * Set PUBLIC_WEB3FORMS_KEY to enable the form. Without it the page falls
 * back to direct contact rather than rendering a form that goes nowhere.
 */
const formKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const formEnabled = formKey.length > 0;

const channels = [
  { label: 'Email', value: site.email, href: `mailto:${site.email}`, copy: site.email },
  { label: 'LinkedIn', value: 'in/pavan-venigalla', href: site.links.linkedin, copy: null },
  { label: 'GitHub', value: 'pavansatya', href: site.links.github, copy: null },
  {
    label: 'Research paper',
    value: `${publication.venue}, ${publication.year}`,
    href: publication.url,
    copy: null,
  },
];
---

<Base
  title="Contact"
  description="Get in touch with Pavan Venigalla — hiring, data platform problems, or comparing notes on Delta Lake."
>
  <section class="shell pt-14 pb-16 sm:pt-20">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <div class="label mb-3">Contact</div>
        <h1 class="max-w-[14ch] text-4xl leading-[1.05] text-fg sm:text-5xl">Say hello.</h1>
        <p class="mt-6 max-w-[48ch] leading-relaxed text-fg-dim">
          Hiring, a data platform problem you are stuck on, or just comparing notes on Spark — all
          welcome. I reply to everything.
        </p>

        <div class="mt-10 flex flex-col gap-2.5">
          {
            channels.map((c) => (
              <div class="flex items-center gap-2">
                <a
                  href={c.href}
                  target={c.href.startsWith('mailto') ? undefined : '_blank'}
                  rel="noopener"
                  class="group flex flex-1 items-center justify-between gap-4 rounded-lg border border-line bg-panel px-5 py-4 transition-colors hover:border-accent/50"
                >
                  <span class="text-sm font-medium text-fg">{c.label}</span>
                  <span class="truncate font-mono text-xs text-fg-dim group-hover:text-accent">
                    {c.value}
                  </span>
                </a>
                {c.copy && (
                  <button
                    type="button"
                    data-copy={c.copy}
                    class="shrink-0 rounded-lg border border-line bg-panel px-3 py-4 font-mono text-[11px] text-fg-faint transition-colors hover:border-accent hover:text-accent"
                    aria-label="Copy email address"
                  >
                    copy
                  </button>
                )}
              </div>
            ))
          }
        </div>
      </div>

      <div>
        {
          formEnabled ? (
            <form id="contact-form" class="rounded-xl border border-line bg-panel p-6 sm:p-8">
              <input type="hidden" name="access_key" value={formKey} />
              <input type="hidden" name="subject" value="New message from pavanvenigalla.vercel.app" />
              <input type="hidden" name="from_name" value="Portfolio contact form" />
              {/* honeypot */}
              <input
                type="checkbox"
                name="botcheck"
                class="hidden"
                style="display:none"
                tabindex="-1"
                autocomplete="off"
              />

              <label class="label mb-2 block" for="name">Your name</label>
              <input
                id="name"
                name="name"
                required
                autocomplete="name"
                placeholder="Jane Okafor"
                class="mb-5 w-full rounded-md border border-line bg-canvas px-4 py-3 text-sm text-fg placeholder:text-fg-faint focus:border-accent focus:outline-none"
              />

              <label class="label mb-2 block" for="email">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="you@company.com"
                class="mb-5 w-full rounded-md border border-line bg-canvas px-4 py-3 text-sm text-fg placeholder:text-fg-faint focus:border-accent focus:outline-none"
              />

              <label class="label mb-2 block" for="message">Message</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder="What are you working on?"
                class="mb-5 w-full resize-y rounded-md border border-line bg-canvas px-4 py-3 text-sm text-fg placeholder:text-fg-faint focus:border-accent focus:outline-none"
              />

              <button
                type="submit"
                id="contact-submit"
                class="w-full rounded-md bg-accent px-5 py-3 font-mono text-sm font-medium text-canvas transition-opacity hover:opacity-90 disabled:opacity-50"
              >
                Send message
              </button>

              <p
                id="contact-status"
                role="status"
                aria-live="polite"
                class="mt-4 min-h-[1.25rem] font-mono text-xs text-fg-dim"
              />
            </form>
          ) : (
            <div class="rounded-xl border border-dashed border-line-bright bg-panel p-6 sm:p-8">
              <div class="label mb-3">Form not configured</div>
              <p class="text-sm leading-relaxed text-fg-dim">
                The contact form is wired up but needs an access key before it can deliver mail.
                Until then, email is the fastest way to reach me — it goes straight to my inbox.
              </p>
              <a
                href={`mailto:${site.email}`}
                class="mt-6 inline-block rounded-md bg-accent px-5 py-3 font-mono text-sm font-medium text-canvas transition-opacity hover:opacity-90"
              >
                Email me →
              </a>
            </div>
          )
        }
      </div>
    </div>
  </section>
</Base>

<script>
  // Copy-to-clipboard
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy;
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        const original = btn.textContent;
        btn.textContent = 'copied';
        btn.classList.add('text-accent', 'border-accent');
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove('text-accent', 'border-accent');
        }, 1600);
      } catch {
        /* clipboard blocked — the address is visible next to the button anyway */
      }
    });
  });

  // Contact form — progressive enhancement over a normal POST
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status');
  const submit = document.getElementById('contact-submit') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || !submit) return;

    submit.disabled = true;
    submit.textContent = 'Sending…';
    status.textContent = '';
    status.className = 'mt-4 min-h-[1.25rem] font-mono text-xs text-fg-dim';

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const result = await response.json();

      if (response.ok && result.success) {
        form.reset();
        status.textContent = 'Sent — I will get back to you within a day or two.';
        status.className = 'mt-4 min-h-[1.25rem] font-mono text-xs text-pass';
      } else {
        throw new Error(result.message ?? 'Request failed');
      }
    } catch {
      status.innerHTML =
        'That did not send. Please email <a class="underline" href="mailto:krishvenigalla06@gmail.com">krishvenigalla06@gmail.com</a> instead.';
      status.className = 'mt-4 min-h-[1.25rem] font-mono text-xs text-fail';
    } finally {
      submit.disabled = false;
      submit.textContent = 'Send message';
    }
  });
</script>
