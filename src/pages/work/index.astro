---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';
---

<Base
  title="Work"
  description="Case studies in cloud and data platform engineering — Azure Synapse, Databricks, Delta Lake, CI/CD, governance and pipeline reliability."
>
  <section class="shell pt-14 pb-10 sm:pt-20">
    <div class="label mb-3">Selected work</div>
    <h1 class="max-w-[16ch] text-4xl leading-[1.05] text-fg sm:text-5xl">
      Six projects, start to finish.
    </h1>
    <p class="mt-6 max-w-[58ch] text-base leading-relaxed text-fg-dim">
      Platform work across public health, pharma, consulting and research. Each one covers the
      problem as it actually arrived, the system built for it, and what changed afterwards.
    </p>
  </section>

  <section class="shell pb-6">
    <div class="overflow-hidden rounded-xl border border-line">
      <div
        class="hidden grid-cols-[3rem_1fr_11rem_9rem] gap-5 border-b border-line bg-panel-2 px-5 py-3 font-mono text-[11px] uppercase tracking-wider text-fg-faint lg:grid"
      >
        <span>#</span><span>Project</span><span>Organisation</span><span>Period</span>
      </div>
      {
        projects.map((p, i) => (
          <a
            href={`/work/${p.slug}`}
            class:list={[
              'group block px-5 py-5 transition-colors hover:bg-panel-2 lg:grid lg:grid-cols-[3rem_1fr_11rem_9rem] lg:items-baseline lg:gap-5',
              i !== projects.length - 1 && 'border-b border-line',
            ]}
          >
            <span class="font-mono text-xs text-accent">{p.num}</span>
            <span class="block">
              <span class="block text-base text-fg transition-colors group-hover:text-accent">
                {p.title}
              </span>
              <span class="mt-1.5 block max-w-[62ch] text-sm leading-relaxed text-fg-dim">
                {p.summary}
              </span>
              <span class="mt-3 flex flex-wrap gap-2 lg:hidden">
                <span class="font-mono text-[11px] text-fg-faint">
                  {p.org} · {p.period}
                </span>
              </span>
            </span>
            <span class="hidden font-mono text-[11px] text-fg-dim lg:block">{p.org}</span>
            <span class="hidden font-mono text-[11px] text-fg-faint lg:block">{p.period}</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>
