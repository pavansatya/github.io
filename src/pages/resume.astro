---
import Base from '../layouts/Base.astro';
import { site, education, certifications } from '../data/site';
import { roles, profileSummary } from '../data/roles';
import { skillGroups } from '../data/skills';

const statusNote: Record<string, string> = {
  active: '',
  'in-progress': ' (in progress)',
  lapsed: ' (lapsed)',
};
---

<Base
  title="Résumé"
  description="Résumé of Pavan Satya Krishna Venigalla — Data Analytics Engineer. Azure, Databricks, Delta Lake, CI/CD and data platform engineering."
>
  <section class="shell pt-14 pb-8 sm:pt-20">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <div class="label mb-3">Résumé</div>
        <h1 class="text-4xl leading-tight text-fg sm:text-5xl">The full version</h1>
        <p class="mt-4 max-w-[48ch] text-fg-dim">On the page, or as a PDF.</p>
      </div>
      <a
        href={site.links.resumePdf}
        download
        class="rounded-md bg-accent px-5 py-3 font-mono text-sm font-medium text-canvas transition-opacity hover:opacity-90"
        >Download PDF ↓</a
      >
    </div>
  </section>

  <section class="shell pb-10">
    <article id="resume-sheet" class="rounded-xl border border-line bg-panel p-6 sm:p-10">
      <!-- header -->
      <header class="border-b border-line pb-7">
        <h2 class="text-2xl text-fg sm:text-3xl">{site.name}</h2>
        <p class="mt-2 font-mono text-sm text-accent">{site.role}</p>
        <p class="mt-3 font-mono text-xs text-fg-faint">
          {site.location} ·
          <a href={`mailto:${site.email}`} class="link-underline hover:text-accent">{site.email}</a>
        </p>
      </header>

      <!-- summary -->
      <section class="border-b border-line py-7">
        <h3 class="label mb-4">Profile</h3>
        <ul class="flex flex-col gap-2.5">
          {
            profileSummary.map((s) => (
              <li class="flex gap-3 text-sm leading-relaxed text-fg-dim">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent" />
                {s}
              </li>
            ))
          }
        </ul>
      </section>

      <!-- experience -->
      <section class="border-b border-line py-7">
        <h3 class="label mb-5">Experience</h3>
        <div class="flex flex-col gap-8">
          {
            roles.map((r) => (
              <div>
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <span class="text-base font-semibold text-fg">
                    {r.title} — {r.org}
                  </span>
                  <span class="font-mono text-[11px] whitespace-nowrap text-fg-faint">
                    {r.period}
                  </span>
                </div>
                <div class="mt-1 font-mono text-[11px] text-fg-faint">{r.place}</div>
                <ul class="mt-3.5 flex flex-col gap-2.5">
                  {r.bullets.map((b) => (
                    <li class="flex gap-3 text-sm leading-relaxed text-fg-dim">
                      <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-fg-faint" />
                      {b}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <!-- skills -->
      <section id="skills" class="border-b border-line py-7">
        <h3 class="label mb-5">Technical skills</h3>
        <dl class="flex flex-col gap-4">
          {
            skillGroups.map((g) => (
              <div class="grid gap-1.5 sm:grid-cols-[13rem_1fr] sm:gap-5">
                <dt class="font-mono text-[11px] uppercase tracking-wider text-fg-faint sm:pt-0.5">
                  {g.label}
                </dt>
                <dd class="text-sm leading-relaxed text-fg-dim">{g.items.join(' · ')}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <!-- education + certs -->
      <section class="pt-7">
        <h3 class="label mb-5">Education & certifications</h3>
        <div class="flex flex-col gap-3 text-sm text-fg-dim">
          {
            education.map((e) => (
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <span>
                  {e.degree} — {e.org}
                  {e.note && <span class="text-fg-faint"> · {e.note}</span>}
                </span>
                <span class="font-mono text-[11px] text-fg-faint">{e.period}</span>
              </div>
            ))
          }
          <div class="mt-2 border-t border-line pt-4">
            {
              certifications.map((c) => (
                <div class="mb-1.5">
                  {c.name}
                  <span class="text-fg-faint">{statusNote[c.status]}</span>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </article>
  </section>
</Base>
